# MongoDB (required)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/

# Auth secret (required for signing sessions/tokens)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# SMTP for consultation form emails (required for email delivery)
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
TO_EMAIL=

# Optional local API port
API_PORT=3001

